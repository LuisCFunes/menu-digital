---
import { getDatabase } from '../db/schema.js';
const hasTurso = !!process.env.TURSO_DATABASE_URL;
const tursoStart = hasTurso ? process.env.TURSO_DATABASE_URL.substring(0, 30) : 'none';
const hasDbPath = !!process.env.DB_PATH;
const dbPath = process.env.DB_PATH || 'none';

let slugs = [];
let error = '';
try {
  const db = await getDatabase();
  const res = await db.execute("SELECT slug, name FROM restaurants");
  slugs = res.rows;
} catch (e) {
  error = e.message;
}
---
<!DOCTYPE html>
<html>
<body>
  <h1>Debug Info V2</h1>
  <p>Has TURSO_DATABASE_URL: {hasTurso}</p>
  <p>TURSO_DATABASE_URL starts with: {tursoStart}</p>
  <p>Has DB_PATH: {hasDbPath}</p>
  <p>DB_PATH: {dbPath}</p>
  <hr>
  <h2>Restaurants in DB</h2>
  {error ? <p style="color:red">Error: {error}</p> : null}
  <ul>
    {slugs.map(r => <li>Slug: {r.slug} | Name: {r.name}</li>)}
  </ul>
</body>
</html>
