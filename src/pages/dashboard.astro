---
import Layout from '../layouts/Layout.astro';
import { getSingleRestaurant, getCategoriesByRestaurant, getMenuItemsByRestaurant } from '../db/queries';

const restaurant = await getSingleRestaurant();

if (!restaurant) {
  return new Response('Restaurant not configured. Run: npm run seed', {
    status: 503,
    headers: { 'Content-Type': 'text/plain' },
  });
}
import { isDashboardAuthenticated } from '../lib/auth';

const isAuthenticated = await isDashboardAuthenticated(Astro.cookies);

const categories = await getCategoriesByRestaurant(restaurant.id);
const menuItems = await getMenuItemsByRestaurant(restaurant.id);

const categorizedItems = categories.map(category => ({
  ...category,
  items: menuItems.filter(item => item.category_id === category.id)
}));
---

<Layout title="Dashboard - MenuDigital">
  <div class="min-h-screen bg-gray-950">
    {!isAuthenticated ? (
      <div id="passwordGate" class="min-h-screen flex items-center justify-center">
        <div class="bg-gray-900 p-8 rounded-lg shadow-lg w-full max-w-md">
          <h1 class="text-2xl font-bold text-white mb-6 text-center">Dashboard Access</h1>
          <form id="passwordForm" class="space-y-4">
            <div>
              <label for="password" class="block text-sm font-medium text-gray-300 mb-1">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500"
              />
            </div>
            <div id="passwordError" class="text-red-500 text-sm hidden"></div>
            <button
              type="submit"
              class="w-full bg-red-600 text-white py-2 px-4 rounded-md hover:bg-red-700 transition-colors"
            >
              Access Dashboard
            </button>
          </form>
        </div>
      </div>
    ) : (
      <div id="dashboardContent" class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-8">
          <div>
            <h1 class="text-3xl font-bold text-white">{restaurant.name}</h1>
            <p class="text-gray-400">Dashboard</p>
          </div>
          <div class="flex gap-2">
            <a href="/" target="_blank" class="bg-gray-700 text-white px-4 py-2 rounded-md hover:bg-gray-600 transition-colors">View Menu</a>
            <button id="logoutBtn" class="bg-gray-700 text-white px-4 py-2 rounded-md hover:bg-gray-600 transition-colors">Logout</button>
          </div>
        </div>


        <div class="flex gap-4 mb-8">
          <button class="tab-btn px-4 py-2 rounded-md bg-red-600 text-white font-medium" data-tab="menu">Menu</button>
          <button class="tab-btn px-4 py-2 rounded-md bg-gray-800 text-gray-300 font-medium hover:bg-gray-700" data-tab="settings">Settings</button>
          <button class="tab-btn px-4 py-2 rounded-md bg-gray-800 text-gray-300 font-medium hover:bg-gray-700" data-tab="qr">QR Code</button>
        </div>

        
        <div id="menuTab" class="tab-content">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2">
              
              <div class="bg-gray-900 rounded-lg p-6 mb-8">
                <h2 class="text-xl font-semibold text-white mb-4">Add Menu Item</h2>
                <form id="addItemForm" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="itemName" class="block text-sm font-medium text-gray-300 mb-1">Name</label>
                    <input type="text" id="itemName" name="name" required class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
                  </div>
                  <div>
                    <label for="itemPrice" class="block text-sm font-medium text-gray-300 mb-1">Price (L)</label>
                    <input type="number" id="itemPrice" name="price" step="0.01" required class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
                  </div>
                  <div>
                    <label for="itemCategory" class="block text-sm font-medium text-gray-300 mb-1">Category</label>
                    <select id="itemCategory" name="category_id" required class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500">
                      {categories.map(category => (
                        <option value={category.id}>{category.name}</option>
                      ))}
                    </select>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-300 mb-1">Image (Upload or URL)</label>
                    <div class="flex flex-col gap-3">
                      <div class="flex items-center gap-3">
                        <label for="itemImageUpload" class="cursor-pointer bg-gray-800 border border-gray-600 hover:bg-gray-700 text-white text-sm font-medium py-2 px-4 rounded-md transition-colors whitespace-nowrap shadow-sm">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                          Upload File
                        </label>
                        <span id="itemImageFileName" class="text-sm text-gray-400 truncate">No file chosen</span>
                        <input type="file" id="itemImageUpload" accept="image/*" class="hidden file-upload-input" data-filename-id="itemImageFileName" />
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="text-xs text-gray-500 font-semibold uppercase">OR</span>
                        <input type="text" id="itemImage" name="image" placeholder="Paste image URL here" class="flex-1 px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white text-sm focus:outline-none focus:ring-2 focus:ring-red-500" />
                      </div>
                    </div>
                  </div>
                  <div class="md:col-span-2">
                    <label for="itemDescription" class="block text-sm font-medium text-gray-300 mb-1">Description (Optional)</label>
                    <textarea id="itemDescription" name="description" rows="2" class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500"></textarea>
                  </div>
                  <div class="md:col-span-2">
                    <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 transition-colors">Add Item</button>
                  </div>
                </form>
                <div id="addItemError" class="text-red-500 text-sm mt-4 hidden"></div>
              </div>

              
              <div class="bg-gray-900 rounded-lg p-6">
                <h2 class="text-xl font-semibold text-white mb-4">Menu Items</h2>
                <div id="menuItemsList" class="space-y-6">
                  {categorizedItems.map(category => (
                    category.items.length > 0 && (
                      <div data-category-id={category.id}>
                        <h3 class="text-lg font-medium text-red-500 mb-3 border-b border-gray-800 pb-1">{category.name}</h3>
                        <div class="space-y-2 category-items" data-category={category.name}>
                          {category.items.map(item => (
                            <div class="flex justify-between items-center bg-gray-800 p-3 rounded-md" data-item-id={item.id}>
                              <div class="flex items-center gap-3">
                                {item.image && <img src={item.image} alt={item.name} class="w-10 h-10 object-cover rounded" />}
                                <div>
                                  <p class="text-white font-medium">{item.name}</p>
                                  <p class="text-gray-400 text-sm">L {item.price.toFixed(2)}</p>
                                </div>
                              </div>
                              <div class="flex gap-2">
                                <button class="edit-item-btn text-gray-400 hover:text-white" data-id={item.id}>
                                  Edit
                                </button>
                                <button class="delete-item-btn text-red-500 hover:text-red-400" data-id={item.id}>
                                  Delete
                                </button>
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                    )
                  ))}
                </div>
              </div>
            </div>

            <div>
              
              <div class="bg-gray-900 rounded-lg p-6">
                <h2 class="text-xl font-semibold text-white mb-4">Categories</h2>
                <form id="addCategoryForm" class="space-y-4 mb-6">
                  <div>
                    <label for="categoryName" class="block text-sm font-medium text-gray-300 mb-1">New Category</label>
                    <div class="flex gap-2">
                      <input type="text" id="categoryName" name="name" required class="flex-1 px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
                      <button type="submit" class="bg-gray-700 text-white px-4 py-2 rounded-md hover:bg-gray-600 transition-colors">Add</button>
                    </div>
                  </div>
                </form>
                <div id="addCategoryError" class="text-red-500 text-sm mb-4 hidden"></div>

                <div class="space-y-2" id="categoriesList">
                  {categories.map((category, index) => (
                    <div class="flex justify-between items-center bg-gray-800 p-3 rounded-md group" data-cat-id={category.id}>
                      <span class="text-white">{category.name}</span>
                      <div class="flex items-center gap-2">
                        {index > 0 && (
                          <button class="move-category-btn text-gray-500 hover:text-white transition-colors p-1" data-id={category.id} data-dir="up" title="Mover arriba">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                              <path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd" />
                            </svg>
                          </button>
                        )}
                        {index < categories.length - 1 && (
                          <button class="move-category-btn text-gray-500 hover:text-white transition-colors p-1" data-id={category.id} data-dir="down" title="Mover abajo">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                          </button>
                        )}
                        <button class="delete-category-btn text-red-500 hover:text-red-400 text-sm ml-2" data-id={category.id}>
                          Eliminar
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        
        <div id="settingsTab" class="tab-content hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            
            <div class="bg-gray-900 rounded-lg p-6">
              <h2 class="text-xl font-semibold text-white mb-4">Restaurant Settings</h2>
              <form id="settingsForm" class="space-y-4">
                <div>
                  <label for="settingsName" class="block text-sm font-medium text-gray-300 mb-1">Restaurant Name</label>
                  <input type="text" id="settingsName" name="name" value={restaurant.name} class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-300 mb-1">Logo (Upload or URL)</label>
                  <div class="flex flex-col gap-3">
                    <div class="flex items-center gap-3">
                      <label for="settingsLogoUpload" class="cursor-pointer bg-gray-800 border border-gray-600 hover:bg-gray-700 text-white text-sm font-medium py-2 px-4 rounded-md transition-colors whitespace-nowrap shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                        Upload Logo
                      </label>
                      <span id="settingsLogoFileName" class="text-sm text-gray-400 truncate">No file chosen</span>
                      <input type="file" id="settingsLogoUpload" accept="image/*" class="hidden file-upload-input" data-filename-id="settingsLogoFileName" />
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-xs text-gray-500 font-semibold uppercase">OR</span>
                      <input type="text" id="settingsLogo" name="logo" value={restaurant.logo || ''} placeholder="Paste logo URL here" class="flex-1 px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white text-sm focus:outline-none focus:ring-2 focus:ring-red-500" />
                    </div>
                  </div>
                  {restaurant.logo && <img src={restaurant.logo} alt="Logo preview" class="h-16 w-auto max-w-full object-contain mt-3 rounded shadow-sm border border-gray-700 bg-gray-800" id="formLogoPreview" />}
                </div>
                <div>
                  <label for="settingsLogoSize" class="block text-sm font-medium text-gray-300 mb-1">Logo Size: <span id="logoSizeValue">{restaurant.logo_size || 128}</span>px</label>
                  <input type="range" id="settingsLogoSize" name="logo_size" min="50" max="250" value={restaurant.logo_size || 128} class="w-full" />
                </div>

                <div>
                  <label for="settingsPrimaryColor" class="block text-sm font-medium text-gray-300 mb-1">Primary Color (Accent)</label>
                  <div class="flex items-center gap-3">
                    <input type="color" id="settingsPrimaryColor" name="primary_color" value={restaurant.primary_color} class="w-16 h-10 bg-gray-800 border border-gray-700 rounded-md cursor-pointer" />
                    <span id="primaryColorLabel" class="text-gray-300 font-mono text-sm uppercase px-3 py-2 bg-gray-800 border border-gray-700 rounded-md">{restaurant.primary_color}</span>
                  </div>
                </div>
                <div>
                  <label for="settingsSecondaryColor" class="block text-sm font-medium text-gray-300 mb-1">Secondary Color (Background)</label>
                  <div class="flex items-center gap-3">
                    <input type="color" id="settingsSecondaryColor" name="secondary_color" value={restaurant.secondary_color} class="w-16 h-10 bg-gray-800 border border-gray-700 rounded-md cursor-pointer" />
                    <span id="secondaryColorLabel" class="text-gray-300 font-mono text-sm uppercase px-3 py-2 bg-gray-800 border border-gray-700 rounded-md">{restaurant.secondary_color}</span>
                  </div>
                </div>
                <div>
                  <label for="settingsTextColor" class="block text-sm font-medium text-gray-300 mb-1">Text Color</label>
                  <div class="flex items-center gap-3">
                    <input type="color" id="settingsTextColor" name="text_color" value={restaurant.text_color} class="w-16 h-10 bg-gray-800 border border-gray-700 rounded-md cursor-pointer" />
                    <span id="textColorLabel" class="text-gray-300 font-mono text-sm uppercase px-3 py-2 bg-gray-800 border border-gray-700 rounded-md">{restaurant.text_color}</span>
                  </div>
                </div>
                <div>
                  <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 transition-colors">Save Settings</button>
                </div>
              </form>
              <div id="settingsSuccess" class="text-green-500 text-sm mt-4 hidden"></div>
              <div id="settingsError" class="text-red-500 text-sm mt-4 hidden"></div>
            </div>

            
            <div class="bg-gray-900 rounded-lg p-6">
              <h2 class="text-xl font-semibold text-white mb-6">Live Preview</h2>
              
              <div id="livePreviewContainer" class="border border-gray-700 rounded-xl overflow-hidden shadow-2xl transition-colors duration-300 w-full max-w-sm mx-auto min-h-[450px] p-6 text-center" style={`background-color: ${restaurant.secondary_color}; color: ${restaurant.text_color};`}>
                
                <img 
                  id="previewLogo" 
                  src={restaurant.logo || '/images/placeholder.jpg'} 
                  alt="Logo" 
                  class="object-cover rounded-full mx-auto mb-4 border-4 shadow-md transition-all duration-300" 
                  style={`border-color: ${restaurant.primary_color}; width: ${restaurant.logo_size || 128}px; height: ${restaurant.logo_size || 128}px; ${restaurant.logo ? '' : 'display:none;'}`} 
                />
                
                <h3 id="previewName" class="text-2xl font-bold mb-6">{restaurant.name}</h3>
                  
                  <div class="text-left mb-4">
                    <h4 class="text-xl font-bold border-b-2 pb-1 transition-colors duration-300" id="previewCategoryBorder" style={`border-color: ${restaurant.primary_color};`}>
                      Destacados
                    </h4>
                  </div>
                  
                  <div class="bg-black/20 rounded-xl shadow-md overflow-hidden text-left">
                    <div class="aspect-video w-full overflow-hidden bg-black/40">
                      <div class="w-full h-full flex items-center justify-center opacity-50">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                      </div>
                    </div>
                    <div class="p-4">
                      <h3 class="text-lg font-semibold" id="previewItemName">Ejemplo de Platillo</h3>
                      <p id="previewPrice" class="text-xl font-bold mt-1 transition-colors duration-300" style={`color: ${restaurant.primary_color};`}>L 150.00</p>
                    </div>
                  </div>
                  
                  <div class="mt-6 flex justify-center gap-2">
                    <span id="previewButton" class="px-4 py-2 rounded-full text-white text-sm font-medium transition-colors duration-300" style={`background-color: ${restaurant.primary_color};`}>
                      Filtro Activo
                    </span>
                    <span class="px-4 py-2 rounded-full border border-current opacity-70 text-sm font-medium" style={`color: ${restaurant.text_color};`}>
                      Inactivo
                    </span>
                  </div>
              </div>
            </div>
          </div>
        </div>

        <div id="qrTab" class="tab-content hidden">
          <div class="bg-gray-900 rounded-lg p-8 max-w-2xl mx-auto text-center mt-10">
            <h2 class="text-3xl font-bold text-white mb-4">Table QR Code</h2>
            <p class="text-gray-400 mb-8 text-lg">Print this QR code and place it on your tables. Customers can scan it to instantly view your digital menu.</p>
            
            <div class="bg-white p-6 rounded-xl inline-block mb-8 border-4 border-gray-800 shadow-2xl">
              <img id="qrCodeImage" src="" alt="Menu QR Code" class="w-64 h-64" />
            </div>

            <div class="flex justify-center gap-4">
              <a id="downloadQrBtn" href="#" target="_blank" download="Menu_QR.png" class="bg-red-600 text-white px-6 py-3 rounded-md hover:bg-red-700 transition-colors font-semibold flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                Download High Quality QR
              </a>
            </div>
          </div>
        </div>

        
        <div id="editModal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-50">
          <div class="bg-gray-900 rounded-lg p-6 w-full max-w-md">
            <h2 class="text-xl font-semibold text-white mb-4">Edit Menu Item</h2>
            <form id="editItemForm" class="space-y-4">
              <input type="hidden" id="editItemId" name="id" />
              <div>
                <label for="editItemName" class="block text-sm font-medium text-gray-300 mb-1">Name</label>
                <input type="text" id="editItemName" name="name" required class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
              </div>
              <div>
                <label for="editItemPrice" class="block text-sm font-medium text-gray-300 mb-1">Price (L)</label>
                <input type="number" id="editItemPrice" name="price" step="0.01" required class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
              </div>
              <div>
                <label for="editItemCategory" class="block text-sm font-medium text-gray-300 mb-1">Category</label>
                <select id="editItemCategory" name="category_id" required class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500">
                  {categories.map(category => (
                    <option value={category.id}>{category.name}</option>
                  ))}
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-300 mb-1">Image (Upload or URL)</label>
                <div class="flex flex-col gap-3">
                  <div class="flex items-center gap-3">
                    <label for="editItemImageUpload" class="cursor-pointer bg-gray-800 border border-gray-600 hover:bg-gray-700 text-white text-sm font-medium py-2 px-4 rounded-md transition-colors whitespace-nowrap shadow-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                      Upload File
                    </label>
                    <span id="editItemFileName" class="text-sm text-gray-400 truncate">No file chosen</span>
                    <input type="file" id="editItemImageUpload" accept="image/*" class="hidden file-upload-input" data-filename-id="editItemFileName" />
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-gray-500 font-semibold uppercase">OR</span>
                    <input type="text" id="editItemImage" name="image" placeholder="Paste image URL here" class="flex-1 px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white text-sm focus:outline-none focus:ring-2 focus:ring-red-500" />
                  </div>
                </div>
              </div>
              <div>
                <label for="editItemDescription" class="block text-sm font-medium text-gray-300 mb-1">Description (Optional)</label>
                <textarea id="editItemDescription" name="description" rows="2" class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:outline-none focus:ring-2 focus:ring-red-500"></textarea>
              </div>
              <div id="editItemError" class="text-red-500 text-sm hidden"></div>
              <div class="flex gap-2 justify-end">
                <button type="button" id="editCancelBtn" class="bg-gray-700 text-white px-4 py-2 rounded-md hover:bg-gray-600 transition-colors">Cancel</button>
                <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 transition-colors">Save Changes</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    )}
  </div>

  <script>
    import '../scripts/dashboard.ts';
  </script>
</Layout>
